# 本地无需密钥，默认仅回环地址
EZLEARN_DATA_DIR=.ezlearn
EZLEARN_BASE_URL=http://127.0.0.1:3210

# 云端必须配置。请使用平台 secrets，切勿提交真实值。
# EZLEARN_API_TOKEN=至少24个随机字符，用于Agent/MCP和Web首次登录
# EZLEARN_SESSION_SECRET=至少32个随机字符，用于HMAC签名会话
# EZLEARN_BACKEND_ID=my-primary
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-token

{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node", "vite/client"]
  },
  "include": ["src", "web", "tests", "deploy", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "deploy/cloudflare/worker-configuration.d.ts"]
}

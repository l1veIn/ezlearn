{
  "name": "ezlearn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "ezlearn": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts start",
    "ezlearn": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/validate-browser.mjs",
    "format:check": "prettier --check src tests web scripts deploy",
    "build:cloudflare": "wrangler deploy --dry-run --config deploy/cloudflare/wrangler.jsonc",
    "build:vercel": "node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@libsql/client": "0.18.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
